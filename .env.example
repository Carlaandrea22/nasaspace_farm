# Solicita o copia la clave del Proyecto 04 desde el portal del GAMC.
GAMC_API_KEY=
# Canales HTTPS autorizados para los avisos de inspección. Vacíos, se comparte la ficha manualmente.
GAMC_INSPECTION_WEBHOOK=
REGANTES_INSPECTION_WEBHOOK=
INSPECTION_WEBHOOK_TOKEN=
# Puerto local de la PWA.
FIELD_SHIFT_PORT=3000
# Cuenta de prueba local. La contraseña se usa al crear la cuenta por primera vez.
FIELD_SHIFT_DEMO_ENABLED=true
FIELD_SHIFT_DEMO_PASSWORD=prueba123
# Contraseña interna de PostgreSQL para un volumen nuevo. Usa caracteres aptos para una URL.
FIELD_SHIFT_DB_PASSWORD=fieldshift-local
